      "localhost": {
        "server": "http://localhost:3000",
        "sse": "http://localhost:3000/sse"
      },
      "usage": {
        "method": "MCP",
        "steps": [
          "1. cd C:/Users/bermi/Projects/chatgpt-mcp-server",
          "2. npm start",
          "3. In ChatGPT: Settings → MCP → Add http://localhost:3000/sse"
        ]
      },
      "tools_provided": [
        "read_file", "write_file", "list_directory", "create_directory",
        "delete_file", "search_files", "get_file_stats", "move_file",
        "execute_command",
        "n8n_list_workflows", "n8n_get_workflow", "n8n_activate_workflow",
        "n8n_deactivate_workflow", "n8n_execute_workflow", "n8n_list_executions"
